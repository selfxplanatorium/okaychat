# 32+ random bytes, used to encrypt provider/MCP credentials and saved memory. Generate: openssl rand -base64 32
OKAYCHAT_SECRET=
# Where SQLite and uploads live
OKAYCHAT_DATA_DIR=./data
PORT=8787
# Allow new users to sign up after the first (admin) account exists
OKAYCHAT_ALLOW_SIGNUP=false
# Public origin for MCP OAuth behind a reverse proxy; otherwise inferred per user
# OKAYCHAT_PUBLIC_URL=https://chat.example.com
# Dev: SearXNG for web search (docker run -d --name okaychat-dev-searxng -p 127.0.0.1:8888:8080 -v $PWD/docker/searxng/settings.yml:/etc/searxng/settings.yml:ro searxng/searxng)
OKAYCHAT_SEARXNG_URL=http://127.0.0.1:8888
# Dev: Scrapling for the local browser worker, via its Docker image (absolute path to scripts/dev-scrapling.sh)
# OKAYCHAT_SCRAPLING_COMMAND=/path/to/okaychat/scripts/dev-scrapling.sh
# OKAYCHAT_SCRAPLING_BROWSER=true
# Chromium for the local browser worker. Defaults to Playwright's registry browser (PLAYWRIGHT_BROWSERS_PATH or ~/.cache/ms-playwright)
# OKAYCHAT_CHROMIUM_PATH=/usr/bin/chromium
# Dev: `npm run dev` starts a browser worker on 127.0.0.1:8791. To use the hardened container from
# scripts/dev-browser.sh instead:
# OKAYCHAT_BROWSER_URL=http://127.0.0.1:8792
# Code sandbox for run_code (sandbox/). Required by docker compose. Generate: openssl rand -base64 32
OKAYCHAT_SANDBOX_TOKEN=
# Dev: start it with scripts/dev-sandbox.sh
OKAYCHAT_SANDBOX_URL=http://127.0.0.1:8790
# Minutes an unused sandbox workspace may survive before the runner wipes it (default 30). The app
# copies produced files into its own storage right after each run, so nothing of value is lost.
# SANDBOX_IDLE_MINUTES=30
# Per-user storage quota in bytes (default 1 GiB). Admins can override it per user in settings.
# OKAYCHAT_STORAGE_LIMIT=1073741824
# Codex CLI used for image generation (each user connects their own ChatGPT plan in Settings)
# OKAYCHAT_CODEX_COMMAND=codex
