# 32+ random bytes, used to encrypt provider keys and sign sessions. Generate: openssl rand -base64 32
OKAYCHAT_SECRET=
# Where SQLite and uploads live
OKAYCHAT_DATA_DIR=./data
PORT=8787
# Allow new users to sign up after the first (admin) account exists
OKAYCHAT_ALLOW_SIGNUP=false
# Dev: SearXNG for web search (docker run -d --name okaychat-dev-searxng -p 127.0.0.1:8888:8080 -v $PWD/docker/searxng/settings.yml:/etc/searxng/settings.yml:ro searxng/searxng)
OKAYCHAT_SEARXNG_URL=http://127.0.0.1:8888
# Dev: Scrapling via the Docker image (absolute path to scripts/dev-scrapling.sh)
# OKAYCHAT_SCRAPLING_COMMAND=/path/to/okaychat/scripts/dev-scrapling.sh
# OKAYCHAT_SCRAPLING_BROWSER=true
