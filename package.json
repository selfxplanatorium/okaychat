{
  "name": "okaychat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "HOST=127.0.0.1 tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite --host ${OKAYCHAT_DEV_HOST:-$(tailscale ip -4 2>/dev/null || echo 127.0.0.1)}",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "node --test --import tsx 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@ai-sdk/google": "^4.0.99",
    "@ai-sdk/mcp": "^2.0.78",
    "@ai-sdk/openai": "^4.0.96",
    "@ai-sdk/openai-compatible": "^3.0.71",
    "@ai-sdk/react": "^4.0.147",
    "@assistant-ui/ai-sdk": "^0.0.13",
    "@assistant-ui/react": "^0.15.29",
    "@assistant-ui/react-markdown": "^0.14.23",
    "@base-ui/react": "^1.9.0",
    "@hono/node-server": "^2.1.5",
    "@mozilla/readability": "^0.6.0",
    "ai": "^7.0.143",
    "assistant-stream": "^0.3.52",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "culori": "^4.0.2",
    "hono": "^4.13.13",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.59.0",
    "mammoth": "^1.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "turndown": "^7.2.4",
    "tw-shimmer": "^0.4.14",
    "unpdf": "^1.9.1",
    "wouter": "^3.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
