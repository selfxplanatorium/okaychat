{
  "name": "okaychat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web,browser -c blue,magenta,green \"npm:dev:server\" \"npm:dev:web\" \"npm:dev:browser\"",
    "dev:server": "HOST=127.0.0.1 OKAYCHAT_DEV_BROWSER_URL=http://127.0.0.1:8791 tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:browser": "node scripts/dev-browser-worker.mjs",
    "dev:web": "tailscale serve --bg --yes --https=5173 http://127.0.0.1:5173 && vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build && node scripts/compress-web.mjs && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "node --test --import tsx 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@ai-sdk/black-forest-labs": "^2.0.67",
    "@ai-sdk/fal": "^3.0.66",
    "@ai-sdk/google": "^4.0.99",
    "@ai-sdk/mcp": "^2.0.78",
    "@ai-sdk/openai": "^4.0.96",
    "@ai-sdk/openai-compatible": "^3.0.71",
    "@ai-sdk/react": "^4.0.147",
    "@ai-sdk/replicate": "^3.0.66",
    "@ai-sdk/togetherai": "^3.0.76",
    "@ai-sdk/xai": "^5.0.27",
    "@assistant-ui/ai-sdk": "^0.0.13",
    "@assistant-ui/react": "^0.15.29",
    "@assistant-ui/react-markdown": "^0.14.23",
    "@base-ui/react": "^1.9.0",
    "@cantoo/pdf-lib": "^2.11.1",
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/dejavu-sans": "^5.3.0",
    "@fontsource/dejavu-serif": "^5.3.0",
    "@fontsource/ubuntu": "^5.3.0",
    "@fontsource/ubuntu-mono": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@mozilla/readability": "^0.6.0",
    "@tanstack/react-virtual": "^3.14.25",
    "@xmldom/xmldom": "^0.9.12",
    "ai": "^7.0.143",
    "assistant-stream": "^0.3.52",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "culori": "^4.0.2",
    "docx": "^9.12.0",
    "docx-preview": "^0.4.1",
    "exceljs": "^4.4.0",
    "fast-formula-parser": "^1.0.19",
    "fflate": "^0.8.3",
    "generative-frame": "^0.0.6",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.13",
    "imapflow": "^2.10.0",
    "katex": "^0.18.10",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.59.0",
    "mailparser": "^3.14.1",
    "mammoth": "^1.13.0",
    "mermaid": "^12.2.0",
    "nodemailer": "^10.3.1",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "turndown": "^7.2.4",
    "tw-shimmer": "^0.4.14",
    "unpdf": "^1.9.1",
    "wouter": "^3.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "micromark-extension-math": {
      "katex": "$katex"
    }
  }
}
